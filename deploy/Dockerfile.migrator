# syntax=docker/dockerfile:1
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS build
WORKDIR /source
COPY package.json bun.lock ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/executor/package.json ./apps/executor/package.json
COPY packages/domain/package.json ./packages/domain/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/script-sdk/package.json ./packages/script-sdk/package.json
RUN bun install --frozen-lockfile --production --ignore-scripts --filter @payloadbay/domain
COPY packages/domain/src ./packages/domain/src
COPY packages/contracts/src ./packages/contracts/src
COPY scripts/migrate.ts ./scripts/migrate.ts
RUN bun build ./scripts/migrate.ts --target=node --packages=external --outfile=/out/migrate.mjs
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS migrator
ENV NODE_ENV=production
WORKDIR /opt/payloadbay
COPY --from=build --chown=node:node /source/node_modules ./node_modules
COPY --from=build --chown=node:node /source/packages/domain/node_modules ./packages/domain/node_modules
COPY --from=build --chown=node:node /out/migrate.mjs ./packages/domain/migrate.mjs
COPY --chown=node:node packages/domain/drizzle/ ./migrations/
USER node
ENTRYPOINT ["node", "/opt/payloadbay/packages/domain/migrate.mjs"]
CMD ["--directory", "/opt/payloadbay/migrations"]
