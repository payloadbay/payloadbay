# syntax=docker/dockerfile:1
FROM oven/bun:1.3.14@sha256:e10577f0db68676a7024391c6e5cb4b879ebd17188ab750cf10024a6d700e5c4 AS build
WORKDIR /source
COPY package.json bun.lock ./
COPY apps/web/package.json ./apps/web/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/executor/package.json ./apps/executor/package.json
COPY packages/domain/package.json ./packages/domain/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/script-sdk/package.json ./packages/script-sdk/package.json
RUN --mount=type=cache,id=payloadbay-bun-public-1.3.14,target=/root/.bun/install/cache,sharing=locked \
    bun install --frozen-lockfile --production --filter @payloadbay/worker
COPY apps/worker/src ./apps/worker/src
COPY packages/contracts/src ./packages/contracts/src
COPY packages/domain/src ./packages/domain/src
COPY packages/script-sdk/src ./packages/script-sdk/src
RUN bun build ./apps/worker/src/main.ts --target=node --external=graphile-worker --external=pg --external=nodemailer --outfile=/out/worker.mjs
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS worker
ENV NODE_ENV=production PORT=8081
WORKDIR /opt/payloadbay/apps/worker
COPY --from=build --chown=node:node /out/worker.mjs ./worker.mjs
COPY --from=build --chown=node:node /source/node_modules /opt/payloadbay/node_modules
COPY --from=build --chown=node:node /source/apps/worker/node_modules ./node_modules
USER node
EXPOSE 8081
CMD ["node","/opt/payloadbay/apps/worker/worker.mjs"]
