{
	"name": "@payloadbay/product",
	"private": true,
	"packageManager": "bun@1.3.14",
	"scripts": {
		"web:dev": "bun run --cwd apps/web dev",
		"web:build": "bun run --cwd apps/web build",
		"web:start": "bun run --cwd apps/web start",
		"web:lint": "bun run --cwd apps/web lint",
		"web:typecheck": "bun run --cwd apps/web typecheck",
		"test": "bun scripts/tests/run.ts suite",
		"test:file": "bun scripts/tests/run.ts file",
		"test:affected": "bun scripts/tests/run.ts affected",
		"test:unit": "bun scripts/tests/run.ts unit",
		"test:integration": "bun scripts/tests/run.ts node",
		"test:executor": "bun scripts/tests/run.ts executor",
		"test:browser": "bun scripts/tests/run.ts browser",
		"test:deployment": "bun scripts/tests/run.ts deployment",
		"test:coverage": "bun scripts/tests/run.ts coverage",
		"test:coverage:merge": "bun scripts/tests/merge-coverage.ts",
		"test:inventory": "bun scripts/tests/inventory.ts",
		"sandbox:check": "bun scripts/tests/sandbox.ts",
		"tooling:typecheck": "node node_modules/typescript/bin/tsc -p tests/config/tsconfig.json",
		"db:migrate": "node --import tsx scripts/migrate.ts",
		"format": "prettier --write apps packages scripts tests deploy/fixtures .github/tooling package.json .prettierrc.mjs .vscode/settings.json eslint.config.mjs && bun run sdk:generate",
		"format:check": "prettier --check apps packages scripts tests deploy/fixtures .github/tooling package.json .prettierrc.mjs .vscode/settings.json eslint.config.mjs",
		"lint": "eslint apps packages scripts tests deploy/fixtures eslint.config.mjs .github/tooling",
		"typecheck": "bun run web:typecheck && bun run tooling:typecheck",
		"db:push": "node --import tsx scripts/database/push.ts",
		"db:generate": "bun scripts/database/migration-policy.ts generate && bun run --cwd packages/domain db:generate",
		"db:generate:ci": "bun scripts/database/generate-ci.ts",
		"db:check-migration-policy": "bun scripts/database/migration-policy.ts staged",
		"sdk:generate": "bun scripts/generate-sdk.ts",
		"test:performance": "bun scripts/tests/run.ts performance"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"devDependencies": {
		"@playwright/test": "1.64.0",
		"@types/bun": "1.3.14",
		"@types/istanbul-lib-coverage": "2.0.6",
		"@types/node": "22.19.0",
		"@types/nodemailer": "6.4.17",
		"@types/pg": "8.15.5",
		"c8": "12.0.0",
		"esbuild": "0.28.2",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.0",
		"istanbul-lib-coverage": "3.2.2",
		"nodemailer": "10.1.0",
		"pg": "8.23.1",
		"prettier": "3.9.9",
		"tsx": "4.20.6",
		"typescript": "5.9.3",
		"v8-to-istanbul": "9.3.0",
		"workerd": "1.20261013.1"
	},
	"trustedDependencies": [
		"heroui-pro",
		"@heroui-pro/react"
	],
	"type": "module"
}
