{
  "name": "@payloadbay/product",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "analyze": "fallow --production",
    "analyze:audit": "fallow audit --production",
    "analyze:dead-code": "fallow dead-code --production",
    "analyze:dupes": "fallow dupes --production --ci",
    "analyze:health": "fallow health --production",
    "analyze:security": "fallow security",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "quality": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run analyze:audit && bun run analyze:dupes",
    "supabase:start": "bunx supabase start",
    "supabase:status": "bun scripts/supabase-status-cli.ts",
    "supabase:reset": "bunx supabase db reset --local",
    "supabase:stop": "bunx supabase stop",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "4.1.10",
    "fallow": "3.12.0",
    "supabase": "2.111.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
